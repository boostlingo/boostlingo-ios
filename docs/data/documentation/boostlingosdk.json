{"topicSections":[{"anchor":"Classes","identifiers":["doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLFilteringLogger","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLNullLogger","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLPrintLogger","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/Boostlingo"],"generated":true,"title":"Classes"},{"anchor":"Protocols","identifiers":["doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLAICall","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLCall","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLLogger","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLVideoCall","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLVoiceCall","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/CustomField"],"generated":true,"title":"Protocols"},{"anchor":"Structures","identifiers":["doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/AIPolicy","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/AdditionalField","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLParticipant","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/CallDetails","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/CallDictionaries","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/CallRequest","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/ChatMessage","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/ChatUser","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/CheckBoxCustomField","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/CustomFieldIdValue","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/CustomFieldOption","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/CustomForm","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/EditTextCustomField","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/Gender","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/ImageInfo","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/Language","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/ListMultipleCustomField","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/ListSingleCustomField","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/Profile","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/RadioButtonCustomField","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/ServiceType"],"generated":true,"title":"Structures"},{"anchor":"Enumerations","identifiers":["doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLCallFlowEvent","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLChatFlowEvent","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLError","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLLogLevel","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLParticipantState","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/BLParticipantType","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/DataError","doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/FieldType"],"generated":true,"title":"Enumerations"}],"identifier":{"url":"doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"https:\/\/github.com\/boostlingo\/boostlingo-ios\/tree\/master","type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"https:\/\/boostlingo.github.io\/boostlingo-ios\/documentation\/boostlingosdk\/","type":"reference","isActive":true}]}]}],"type":"unorderedList"},{"type":"heading","text":"Getting Started","anchor":"Getting-Started","level":2},{"type":"paragraph","inlineContent":[{"text":"In order to place calls in Boostlingo, you must have a requestor account. You can then embed Boostlingo iOS SDK into your application, request a Boostlingo API token from your server, and start making calls.","type":"text"}]},{"type":"heading","text":"Installation","anchor":"Installation","level":2},{"type":"heading","text":"Swift Package Manager (recommended)","anchor":"Swift-Package-Manager-recommended","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"You can add this SDK to your project using "},{"type":"reference","identifier":"https:\/\/swift.org\/package-manager\/","isActive":true},{"type":"text","text":":"}]},{"items":[{"content":[{"inlineContent":[{"text":"In Xcode, go to ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File > Add Packages…"}]}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Enter the repository URL: https:\/\/github.com\/boostlingo\/boostlingo-ios.git","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Select the version you want to install and add the package to your target."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Or add it directly to your "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":" dependencies:"}]},{"type":"codeListing","code":["dependencies: ["," .package(url: \"https:\/\/github.com\/boostlingo\/boostlingo-ios.git\", from: \"2.1.0\")","]"],"syntax":"swift"},{"type":"heading","text":"Usage","anchor":"Usage","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"These steps will guide you through the basic process of placing calls through Boostlingo."}]},{"level":3,"anchor":"Request-Boostlingo-authentication-token","text":"Request Boostlingo authentication token","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"First step is to obtain a boostlingo authentication token from your server.  Never store an API token or username\/password in your front end\/mobile code.  Your server should be the one that logs the user in, obtains the authentication token, and passes it back down to the web application.","type":"text"}]},{"text":"Obtain Boostlingo authentication token via API endpoint","type":"heading","level":3,"anchor":"Obtain-Boostlingo-authentication-token-via-API-endpoint"},{"type":"codeListing","code":["POST https:\/\/app.boostlingo.com\/api\/web\/account\/signin"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Request Model","type":"text"}]},{"type":"codeListing","code":["{","\"email\": \"<string>\",","\"password\": \"<string>\"","}"],"syntax":"json"},{"type":"paragraph","inlineContent":[{"text":"Response Model","type":"text"},{"text":" ","type":"text"},{"code":"token","type":"codeVoice"},{"text":" is what will be needed by the boostlingo sdk","type":"text"}]},{"type":"codeListing","code":["{","\"userAccountId\": \"<integer>\",","\"refreshToken\": \"<string>\",","\"role\": \"<string>\",","\"token\": \"<string>\",","\"companyAccountId\": \"<integer>\"","}"],"syntax":"json"},{"text":"Quickstart","type":"heading","level":3,"anchor":"Quickstart"},{"type":"paragraph","inlineContent":[{"text":"This is a working example that will demonstrate how to make Boostlingo calls.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Update the placeholder of TOKEN with the token you got from the API."}]},{"code":["let boostlingo = Boostlingo(authToken: \"your token\", region: \"us\", logger: BLPrintLogger())"],"syntax":"swift","type":"codeListing"},{"text":"Create instance of Boostlingo class and load dictionaries","level":3,"anchor":"Create-instance-of-Boostlingo-class-and-load-dictionaries","type":"heading"},{"inlineContent":[{"text":"Async ","type":"text"},{"code":"initialize()","type":"codeVoice"},{"text":" method must be called after creating an instance of ","type":"text"},{"code":"Boostlingo","type":"codeVoice"},{"text":" to ensure all internal services are fully configured and ready to use. The library will cache specific data and create instances of classes that do not need to be refreshed very frequently. The next step is typically to pull down the call dictionaries. Whether you expose these directly or are just mapping languages and service types with your internal types, loading these lists will almost definitely be required.","type":"text"}],"type":"paragraph"},{"code":["\/\/ For production builds use BLNullLogger() or your custom logger.","let boostlingo = Boostlingo(","    authToken: authToken,","    region: \"us\",","    logger: BLPrintLogger()",")","try await boostlingo.initialize()","","\/\/ Pulling down the call dictionaries.","let dictionaries = try await boostlingo.getCallDictionaries()","let languages = dictionaries?.languages ?? []","let serviceTypes = dictionaries?.serviceTypes ?? []","let genders = dictionaries?.genders ?? []"],"syntax":"swift","type":"codeListing"},{"text":"Disposing Boostlingo SDK after use","level":3,"anchor":"Disposing-Boostlingo-SDK-after-use","type":"heading"},{"inlineContent":[{"type":"text","text":"Async "},{"type":"codeVoice","code":"dispose()"},{"type":"text","text":" method should be used when you are finished using the SDK to ensure that all internal resources, such as network connections, memory, and background tasks, are properly released. After calling "},{"type":"codeVoice","code":"dispose()"},{"type":"text","text":", the SDK instance should not be used again."}],"type":"paragraph"},{"code":[" await boostlingo.dispose()"],"syntax":"swift","type":"codeListing"},{"text":"Retrieving the pre-call custom Form","level":3,"anchor":"Retrieving-the-pre-call-custom-Form","type":"heading"},{"inlineContent":[{"type":"text","text":"You can use the "},{"code":"getPreCallCustomForm","type":"codeVoice"},{"type":"text","text":" method to fetch the custom form configuration required before starting a call. This form may include fields that the user needs to fill out prior to initiating a call."},{"type":"text","text":" "},{"type":"text","text":"The "},{"code":"getPreCallCustomForm","type":"codeVoice"},{"type":"text","text":" method returns a "},{"code":"PreCallCustomForm","type":"codeVoice"},{"type":"text","text":" object containing the form fields and metadata. If the form cannot be retrieved, the method will throw an error."}],"type":"paragraph"},{"code":["do {","    let form = try await boostlingo.getPreCallCustomForm()","    \/\/ Present the form to the user.","    print(\"Form title: \\(form.title)\")","    for field in form.fields {","        print(\"Field: \\(field.label) (\\(field.type))\")","    }","} catch {","    print(\"Failed to fetch pre-call custom form: \\(error)\")","}","","...","","let fields = form.fields.map({ customField in","    CustomFieldDto(","        fieldId: customField.fieldId,","        value: \/\/ User answer.","    )","}) ?? []","","...","","let callRequest = CallRequest(","    languageFromId: selectedLanguageFrom,","    languageToId: selectedLanguageTo,","    serviceTypeId: selectedServiceType,","    genderId: selectedGender,","    isVideo: isVideo,","    data: [AdditionalField(key: \"CustomKey\", value: \"CustomValue\")],","    fieldData: fields \/\/ Use your user responses here.",")"],"syntax":"swift","type":"codeListing"},{"text":"Custom form fields","level":4,"anchor":"Custom-form-fields","type":"heading"},{"code":["public struct CheckBoxCustomField: CustomField, Hashable {","    ","    public let fieldId: Int64","    public let fieldTypeId: Int","    public let label: String","    public let readonly: Bool","    public let required: Bool","    public var value: [Int64]?","    public let options: [CustomFieldOption]","}","","public struct EditTextCustomField: CustomField, Hashable {","    ","    public let fieldId: Int64","    public let fieldTypeId: Int","    public let label: String","    public let readonly: Bool","    public let required: Bool","    public var value: String?","    public let fieldType: FieldType","}","","public struct ListMultipleCustomField: CustomField, Hashable {","    ","    public let fieldId: Int64","    public let fieldTypeId: Int","    public let label: String","    public let readonly: Bool","    public let required: Bool","    public var value: [Int64]?","    public let options: [CustomFieldOption]","}","","public struct ListSingleCustomField: CustomField, Hashable {","    ","    public let fieldId: Int64","    public let fieldTypeId: Int","    public let label: String","    public let readonly: Bool","    public let required: Bool","    public var value: Int64?","    public let options: [CustomFieldOption]","}","","public struct RadioButtonCustomField: CustomField, Hashable {","    ","    public let fieldId: Int64","    public let fieldTypeId: Int","    public let label: String","    public let readonly: Bool","    public let required: Bool","    public var value: Int64?","    public let options: [CustomFieldOption]","}"],"syntax":"swift","type":"codeListing"},{"text":"Calls","level":3,"anchor":"Calls","type":"heading"},{"inlineContent":[{"type":"text","text":"Before placing a call you will need to check record permission. It’s required to To initiate a voice call, use the "},{"type":"codeVoice","code":"makeVoiceCall"},{"type":"text","text":" or "},{"type":"codeVoice","code":"makeVideoCall"},{"type":"text","text":" methods provided by the SDK."}],"type":"paragraph"},{"text":"Observing call events","level":4,"anchor":"Observing-call-events","type":"heading"},{"inlineContent":[{"text":"The SDK provides a ","type":"text"},{"code":"callEventStream","type":"codeVoice"},{"text":" property of type ","type":"text"},{"code":"AsyncStream<BLCallFlowEvent>","type":"codeVoice"},{"text":", which allows you to observe call events in a modern, Swift-concurrency-friendly way.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Instead of using weak delegates or callback protocols, you can use "},{"type":"codeVoice","code":"callEventStream"},{"type":"text","text":" to asynchronously receive updates about the call lifecycle, such as connection status, participant changes, or errors."}],"type":"paragraph"},{"code":["func subscribeOnCallEvents() async {","    let callEventTask = Task {","        for await event in await state.boostlingo.callEventStream {","            guard !Task.isCancelled else { break }","            switch event {","            case .callDidConnect(let call, participants: _): break","            case .callDidDisconnect(let error):","                await cancelSubscriptions()","            case .callDidFailToConnect(let error):","                await cancelSubscriptions()","            case .participantConnected(let participant, call: let call): break","            case .participantUpdated(let participant, call: let call): break","            case .participantDisconnected(let participant, call: let call): break","            @unknown default: break","            }","        }","    }","    await state.setCallEventTask(callEventTask)","}","","\/\/ You should cancel the subscriptions once the call is finished.","func cancelSubscriptions() async {","    await state.callEventsTask?.cancel()","    await state.chatEventTask?.cancel()","    await state.setCallEventTask(nil)","    await state.setChatEventTask(nil)","}"],"syntax":"swift","type":"codeListing"},{"text":"Observing chat events","level":4,"anchor":"Observing-chat-events","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The SDK provides a ","type":"text"},{"code":"chatEventStream","type":"codeVoice"},{"text":" property of type ","type":"text"},{"code":"AsyncStream<BLChatFlowEvent>","type":"codeVoice"},{"text":", which allows you to observe chat events in a modern, Swift-concurrency-friendly way.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func subscribeOnChatEvents() async {","    let chatEventTask = Task {","        for await event in await state.boostlingo.chatEventStream {","            guard !Task.isCancelled else { break }","            switch event {","            case .chatConnected: break","            case .chatDisconnected: break","            case .chatMessageReceived(let message):","                print(\"Chat: \\(message.text)\")","            @unknown default: break","            }","        }","    }","    await state.setChatEventTask(chatEventTask)","}","","\/\/ You should cancel the subscriptions once the call is finished.","func cancelSubscriptions() async {","    await state.callEventsTask?.cancel()","    await state.chatEventTask?.cancel()","    await state.setCallEventTask(nil)","    await state.setChatEventTask(nil)","}"]},{"type":"heading","level":4,"anchor":"Observing-AI-Interpreter-events","text":"Observing AI Interpreter events"},{"type":"paragraph","inlineContent":[{"text":"When an AI Interpreter call is active, the same ","type":"text"},{"code":"callEventStream","type":"codeVoice"},{"text":" emits two additional events that report when the AI starts and stops speaking. They complement the standard lifecycle events and are useful for driving UI indicators (a “speaking” animation, for example) or for gating input controls while the AI is responding.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["for await event in await state.boostlingo.callEventStream {","    guard !Task.isCancelled else { break }","    switch event {","    case .aiInterpreterStartedSpeaking(let call):","        isAISpeaking = true","    case .aiInterpreterStoppedSpeaking(let call):","        isAISpeaking = false","    \/\/ Handle the standard lifecycle events as shown in \"Observing call events\".","    default: break","    }","}"]},{"type":"heading","level":4,"anchor":"Initiating-a-voice-call","text":"Initiating a voice call"},{"type":"codeListing","syntax":"swift","code":["func startCall() {","    Task {","        do {","            let callRequest = CallRequest(","                languageFromId: selectedLanguageFrom,","                languageToId: selectedLanguageTo,","                serviceTypeId: selectedServiceType,","                genderId: selectedGender,","                isVideo: false,","                data: [AdditionalField(key: \"CustomKey\", value: \"CustomValue\")],","                fieldData: fields","            )","            await subscribeOnCallEvents()","            await subscribeOnChatEvents()","            let call = try await state.boostlingo.makeVoiceCall(callRequest: callRequest)","            await state.setCall(call)","            callState = .calling","        } catch {","            callState = .noCall","            await showAlert(error.localizedDescription)","            await cancelSubscriptions()","        }","    }","}"]},{"type":"heading","level":4,"anchor":"Initiating-a-video-call","text":"Initiating a video call"},{"type":"paragraph","inlineContent":[{"text":"You don’t have to check the camera permission, the sdk will do it by itself. But you will need to provide ","type":"text"},{"type":"codeVoice","code":"TVIVideoView"},{"text":" container for the remote and local video tracks.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func startCall() {","    Task {","        do {","            let callRequest = CallRequest(","                languageFromId: selectedLanguageFrom,","                languageToId: selectedLanguageTo,","                serviceTypeId: selectedServiceType,","                genderId: selectedGender,","                isVideo: true,","                data: [AdditionalField(key: \"CustomKey\", value: \"CustomValue\")],","                fieldData: fields","            )","            await subscribeOnCallEvents()","            await subscribeOnChatEvents()","            let call = try await state.boostlingo.makeVideoCall(","                callRequest: await callRequest,","                localVideoView: localView","            )","            await state.setCall(call)","            callState = .calling","        } catch {","            callState = .noCall","            await showAlert(error.localizedDescription)","            await cancelSubscriptions()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Later you will need to add a "},{"type":"codeVoice","code":"TVIVideoView"},{"type":"text","text":" as a renderer for remote participants when they join."}]},{"type":"codeListing","syntax":"swift","code":["case .participantConnected(let participant, call: let call):","    print(\"callParticipantConnected\")","    switch participant.participantType {","    case .interpreter:","        if let renderer = await state.removeView {","            await state.call?.addRenderer(","                for: participant.identity,","                renderer: renderer","            )","        }","    case .thirdParty:","        if let renderer = await state.thirdPartyParticipantView {","            await state.call?.addRenderer(","                for: participant.identity,","                renderer: renderer","            )","        }","    default:","        break","    }"]},{"type":"heading","level":4,"anchor":"Initiating-an-AI-Interpreter-call","text":"Initiating an AI Interpreter call"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The AI Interpreter call type uses the Twilio Voice audio path with the Boostlingo AI Interpreter as the remote interlocutor. The returned "},{"type":"codeVoice","code":"BLAICall"},{"type":"text","text":" inherits the full "},{"type":"codeVoice","code":"BLVoiceCall"},{"type":"text","text":" surface (mute, hang up, third-party dialing) and adds an "},{"type":"codeVoice","code":"interrupt()"},{"type":"text","text":" method so the user can stop the AI mid-utterance."}]},{"type":"paragraph","inlineContent":[{"text":"Before offering AI Interpreter in your UI, gate it on availability and load the AI-specific language and service-type dictionaries:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["guard try await boostlingo.isAIInterpreterAvailable() else { return }","let languages = try await boostlingo.getAIInterpreterLanguages() ?? []","let serviceTypes = try await boostlingo.getAIInterpreterServiceTypes() ?? []"]},{"type":"paragraph","inlineContent":[{"text":"Place the call with ","type":"text"},{"type":"codeVoice","code":"makeAIInterpreterCall"},{"text":". The SDK sets the AI flag on the request internally — you do not need to mutate ","type":"text"},{"type":"codeVoice","code":"CallRequest"},{"text":" yourself:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func startCall() {","    Task {","        do {","            let callRequest = CallRequest(","                languageFromId: selectedLanguageFrom,","                languageToId: selectedLanguageTo,","                serviceTypeId: selectedServiceType,","                genderId: nil,","                isVideo: false,","                data: [AdditionalField(key: \"CustomKey\", value: \"CustomValue\")],","                fieldData: fields","            )","            await subscribeOnCallEvents()","            let call = try await state.boostlingo.makeAIInterpreterCall(callRequest: callRequest)","            await state.setCall(call)","            callState = .calling","        } catch {","            callState = .noCall","            await showAlert(error.localizedDescription)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To interrupt the AI while it is speaking:"}]},{"type":"codeListing","syntax":"swift","code":["try await state.call?.interrupt()"]},{"type":"heading","level":4,"anchor":"Sending-a-chat-message","text":"Sending a chat message"},{"type":"codeListing","syntax":"swift","code":["func sendTestMessage() {","    Task {","        do {","            _ = try await state.boostlingo.sendChatMessage(text: \"Test\")","            await showAlert(\"Message sent\")","        } catch {","            await showAlert(error.localizedDescription)","        }","    }","}"]},{"type":"heading","level":3,"anchor":"Geting-profile-image-URL","text":"Geting profile image URL"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Getting requestor profile image url."}]},{"type":"codeListing","syntax":"swift","code":["let url = try await boostlingo.getProfile()?.imageInfo?.url(size: 64)"]},{"type":"paragraph","inlineContent":[{"text":"Getting a participant profile image url from ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"BLCall","type":"text"}]},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Get the interpreter profile image URL","let url = await call?.participants.first?.imageInfo?.url(size: nil)"]}]}],"abstract":[{"type":"text","text":"The Boostlingo iOS Swift library enables developers to embed the Boostlingo caller directly into their own applications. This can then be used for placing calls in the Boostlingo platform."}],"kind":"symbol","hierarchy":{"paths":[[]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/boostlingosdk"]}],"sections":[],"metadata":{"externalID":"BoostlingoSDK","symbolKind":"module","modules":[{"name":"BoostlingoSDK"}],"roleHeading":"Framework","role":"collection","title":"BoostlingoSDK"},"references":{"doc://com.boostlingo.Boostlingo/documentation/BoostlingoSDK/AIPolicy":{"url":"\/documentation\/boostlingosdk\/aipolicy","title":"AIPolicy","identifier":"doc:\/\/com.boostlingo.Boostlingo\/documentation\/BoostlingoSDK\/AIPolicy","navigatorTitle":[{"kind":"identifier","text":"AIPolicy"}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"AIPolicy"}],"role":"symbol","abstract":[{"type":"t